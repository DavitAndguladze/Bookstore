{
  "compilerOptions": {
    // File structure
    "rootDir": "./src",
    "outDir": "./dist",

    // Enables es modules, aligns with modern Node version
    "module": "esnext",
    // Tell typescript how to resolve imports corretly in ESM
    "moduleResolution": "bundler",
    // Modern JavaScript features
    "target": "es2023",
    // Enables Node types
    "types": ["node"],

    "sourceMap": true,
    // Forces good habits, prevents silent bugs
    "strict": true,
    // Helps compatibility with CommonJS libraries
    "esModuleInterop": true,
    // Prevents bugs between Mac/Linux
    "forceConsistentCasingInFileNames": true,
    // Avoids type-checking node_modules, faster builds
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
